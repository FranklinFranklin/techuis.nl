# ==============================================================================
# Techuis ICT - Web Server Configuration (.htaccess)
# ==============================================================================

# 1. Force HTTPS & Canonical Host (non-www)
<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Canonical Host (redirect www.techuis.nl to techuis.nl)
  RewriteCond %{HTTP_HOST} ^www\.techuis\.nl$ [NC]
  RewriteRule ^(.*)$ https://techuis.nl/$1 [L,R=301]

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://techuis.nl%{REQUEST_URI} [L,R=301]
</IfModule>

# 2. Custom Error Pages
ErrorDocument 404 /404.html

# 3. Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# 4. Protect Sensitive Files & Directories
<FilesMatch "^(package\.json|package-lock\.json|tailwind\.config\.js|\.git|\.env)">
  Order allow,deny
  Deny from all
</FilesMatch>

# 5. Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# 6. Browser Caching (Core Web Vitals Optimization)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML
  ExpiresByType text/html "access plus 1 hour"

  # CSS & JavaScript
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Images & Media
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"

  # Fonts
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
</IfModule>
